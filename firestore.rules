rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // users/{uid} - one profile doc per authenticated user, created on first login
    // (see FirebaseService.ensureUserExists). Only the owner can read/write their own doc.
    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      // `role` (and the identity fields) can only be set from the Firebase console / admin SDK:
      // a user must not be able to promote themselves.
      allow create: if isSignedIn() && request.auth.uid == userId
                    && request.resource.data.uid == userId
                    && !('role' in request.resource.data);
      allow update: if isSignedIn() && request.auth.uid == userId
                    && !request.resource.data.diff(resource.data).affectedKeys()
                        .hasAny(['role', 'uid', 'email', 'createdAt']);
      // an account can delete its own profile (AuthService.deleteAccount removes the decks first, then this)
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // decks/{deckId} - owned by the user in createdBy. Any signed-in user
    // (not just the owner) may also READ a deck marked 'public' (listed in
    // the community gallery, DeckService.getPublicDecks) or 'shared'
    // (never listed/queried -- reachable only via a direct link, i.e.
    // getDeckById). Only the owner may ever write to a deck; anyone else
    // viewing a public/shared deck can only clone it into a brand new deck
    // of their own (DeckService.cloneDeck -> a normal `create` below, always
    // as a fresh 'private' doc). Deletion is a real delete, owner-only
    // (DeckService.deckRemove).
    // The original author of a deck is recorded in originalAuthorId/originalAuthorName and must
    // survive copies and edits: it is immutable once set, a new deck must either be authored by its
    // creator or be a copy (clonedFrom) of a deck with that same original author, and a deck can only
    // be public if its original author is known.
    function authorIsValidOnCreate() {
      let d = request.resource.data;
      return d.get('originalAuthorId', null) == request.auth.uid
        || (d.get('clonedFrom', null) != null
            && exists(/databases/$(database)/documents/decks/$(d.clonedFrom))
            && get(/databases/$(database)/documents/decks/$(d.clonedFrom)).data
                 .get('originalAuthorId', get(/databases/$(database)/documents/decks/$(d.clonedFrom)).data.createdBy)
               == d.get('originalAuthorId', null));
    }

    function authorIsPreservedOnUpdate() {
      let before = resource.data.get('originalAuthorId', null);
      let after = request.resource.data.get('originalAuthorId', null);
      // legacy decks (no author yet) may get their owner recorded once
      return before == after || (before == null && after == resource.data.createdBy);
    }

    function publicNeedsAuthor() {
      return request.resource.data.get('visibility', 'private') != 'public'
        || request.resource.data.get('originalAuthorId', null) != null;
    }

    // Publishing in the public gallery needs a verified email (Google accounts always are). The
    // client refreshes the ID token after the user verifies (AuthService.refreshVerification).
    function publicNeedsVerifiedEmail() {
      return request.resource.data.get('visibility', 'private') != 'public'
        || request.auth.token.get('email_verified', false) == true;
    }

    match /decks/{deckId} {
      allow read: if isSignedIn() && (
        resource.data.createdBy == request.auth.uid ||
        resource.data.visibility == 'public' ||
        resource.data.visibility == 'shared'
      );
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.get('visibility', 'private') in ['private', 'shared', 'public']
                    && authorIsValidOnCreate()
                    && publicNeedsAuthor()
                    && publicNeedsVerifiedEmail();
      allow update: if isSignedIn()
                    && resource.data.createdBy == request.auth.uid
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.get('visibility', 'private') in ['private', 'shared', 'public']
                    && authorIsPreservedOnUpdate()
                    && request.resource.data.get('originalAuthorName', null) == resource.data.get('originalAuthorName', request.resource.data.get('originalAuthorName', null))
                    && publicNeedsAuthor()
                    && publicNeedsVerifiedEmail();
      allow delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;
    }

    // Deny everything not explicitly matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
